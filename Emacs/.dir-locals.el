;; Org duration units for this project: 37-hour week, 5-day week
;; (1d = 7h24m = 444 minutes, 1w = 37h = 2220 minutes).
((nil
  (org-duration-units . (("min" . 1)
                         ("h" . 60)
                         ("d" . 444)
                         ("w" . 2220)
                         ("m" . 8880)
                         ("y" . 88800)))))
